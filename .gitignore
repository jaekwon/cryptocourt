# scripts/ became importable in v0.70 (gnoroot.py is shared by every runner),
# so running any of them now leaves bytecode beside the sources. Never source.
__pycache__/
*.selftest-backup

# built by `make chat`: the off-chain chat service binaries
bin/

# CERTIFIED COPIES ARE NOT SOURCE. web/embed/*.html is generated by
# scripts/make-copies.js from live chain state, so a committed copy is a stale
# copy — unlike web/og.png, which is deterministic from its generator and is
# therefore checked in and hash-verified. These are made at deploy time.
web/embed/

# RETARGETED TREES ARE BUILD OUTPUT. scripts/retarget.sh writes one copy per
# namespace, plus a per-chain dependency cache. Generated from the canonical
# source by one command, so a committed copy is only a stale one.
build/
