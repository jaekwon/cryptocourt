[Unit]
Description=Kourt chat service
Documentation=https://github.com/jaekwon/cryptocourt-mod/blob/main/CHAT.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kourt
Group=kourt

# THE SERVICE NEVER TALKS TO THE MODEL. The scanner is a separate process on a
# separate machine (it wants a GPU; this does not), and CHAT.md is explicit that
# accepting, storing, throttling and enforcing must keep working whether or not
# the scanner is running. So this unit orders itself against nothing: an OOM in
# a 7B model on another box cannot take the chat down with it.
#
# --behind-proxy is on because nginx terminates TLS in front of this. WITHOUT
# it the client address is the peer and X-Forwarded-For is ignored entirely,
# which is the safe default for a direct listener but wrong here — every client
# would look like the proxy and the throttle would be one global bucket.
# --trusted-proxy must therefore name the proxy, or the header is still ignored.
# --chain IS NOT OPTIONAL HERE, and leaving it out is why the chat was dead on
# this host: the flag defaults to "dev" alone, the overlay posts to
# /api/chat/{chain}/{court} with the real chain id, and every request came back
# "unknown chain \"kourt-1\"". The service was healthy the whole time and
# answering the only chain it had been told about.
#
# BOTH NAMES, because one binary serves whatever is pointed at it: "dev" keeps a
# local gnodev working against this same service, and kourt-1 is the chain this
# host actually runs. Adding a chain here is the only thing needed to serve it.
#
# --archive-rpc IS WHAT KEEPS FILED PICTURES, and it was missing. Its own help
# says the consequence plainly — "empty disables promotion, so every upload
# expires" — and this unit shipped without it, so on this host the archive held
# every image for an hour and swept it. Uploading worked, the hash went on chain,
# /m/<sha> answered 404 forever, and nothing anywhere failed. Found when the
# first folder was given a picture; it was never about folders.
#
# The archive asks a node whether the chain really references a blob before
# keeping it, so it needs a node to ask. This is the same chain the overlay is
# stamped with at deploy time.
# THE HELPER IN THE CHAT is the --bot at the end of this list.
#
# IT NEEDS BOTH THE FLAG AND A KEY before it runs — see chat.BotRunnable — so
# this flag alone starts nothing, and a key alone starts nothing either. The key
# is set once through /api/chat/botkey and read at startup; one set afterwards
# takes effect at the next restart, which the diagnostics page says out loud.
#
# IN THE UNIT RATHER THAN ONLY ON THE BOX, because deploy.sh installs this file:
# a --bot added by hand on the server is a --bot the next deploy silently
# removes, and the symptom is a helper that stops answering with nothing in the
# log to explain it.
#
# THE COMMENTARY IS UP HERE AND NOT BESIDE THE FLAG because systemd does not
# reliably take comments inside a backslash-continued value — older versions
# fold them into the argument list. A unit that fails to parse does not fail the
# helper, it fails chat.
#
# --bot-gap IS THE FLOOR BETWEEN TWO REPLIES, across every room together, and it
# is ten seconds here against a code default of a minute. Asked for, and the
# reason is what a minute did to a conversation: a reader asked "how do i stake
# on a claim?", got an answer, asked "what wallet?" twenty-four seconds later,
# and was never answered at all — the throttle held the reply and the helper's
# watermark then moved past the question. Follow-ups are the normal shape of a
# conversation, and a minute is longer than one.
#
# WHAT IT COSTS, from this deployment's own numbers: a reply measured 408 input
# and 16 output tokens, about 490 micro-dollars. Six a minute is the new ceiling,
# so a room talking flat out for an hour is roughly $0.18 — and the local filter
# means most messages never reach the model at all. The ceiling is what changed;
# the ordinary bill will not move much.
#
# THE PRICES ARE DEFAULTS AND ARE CONFIGURATION, NOT FACTS: $1 and $5 per
# million tokens for claude-haiku-4-5. Wrong numbers make the "Spent" column on
# the diagnostics page wrong and nothing else — the token counts beside it come
# from the API's own response. Pass --bot-price-in / --bot-price-out to correct
# them against the current price list.
ExecStart=/opt/kourt/kourtchat \
    --addr 127.0.0.1:8788 \
    --db /var/lib/kourt/chat.db \
    --secret-file /var/lib/kourt/secret/iphash.key \
    --chain dev,kourt-1 \
    --archive-rpc https://rpc.kourt.xyz \
    --behind-proxy \
    --trusted-proxy 127.0.0.1/32,::1/128 \
    --bot \
    --bot-gap 10s

Restart=on-failure
RestartSec=2

# The database and the key that reverses its address hashes must not sit in one
# file, and must not sit in one directory either — kourtchat warns about both.
# /var/lib/kourt/secret is a mode-0700 subdirectory for exactly that reason.
StateDirectory=kourt
StateDirectoryMode=0750

# Nothing here needs to write outside its state directory, own a terminal, or
# see the rest of the filesystem.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/var/lib/kourt

[Install]
WantedBy=multi-user.target
