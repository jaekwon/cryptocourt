# Claim media against a real node — the seam every unit test misses.
#
# WHY THIS EXISTS. Every layer of this feature is tested on its own: the realm's
# validator and gate in package kourtv2, the archive in internal/archive, the
# overlay's rules in web/tests. None of that exercises the JOIN — an argument
# built by one program, parsed by another, stored, and read back out over RPC by
# a third. Twice while building this a server-side mechanism was complete and
# dead because its client half was missing, and neither time did any unit test
# notice.
#
# So this files a claim carrying evidence the way a person's browser would, and
# then asks a node the questions the page asks.
#
# Specifically checked: the eight-field argument survives a real transaction and
# comes back as one line of JSON; the claim page names the exhibit and points at
# the ARCHIVE rather than the mirror the filer chose; a batch read answers for a
# run of claims with holes in the right places; and a purge takes the evidence
# off every one of those surfaces at once.

loadpkg gno.land/p/kourt/checkpoint/v0
loadpkg gno.land/p/kourt/grc20votes/v0
loadpkg gno.land/p/kourt/governor/v0
loadpkg gno.land/p/kourt/twap/v0
loadpkg gno.land/p/kourt/curve/v0
loadpkg gno.land/r/kourt/kourtv2

gnoland start

env TEST1=g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5

# --- A court, and the site the archive lives on --------------------------------
# The archive's address is DERIVED from the site domain, so without one the page
# has nowhere to point and falls back to the filer's mirror. Setting it is what
# makes the archive-first rule observable here at all.
gnokey maketx call -pkgpath gno.land/r/kourt/kourtv2 -func StartCourt -args med -args 'Media Court' -gas-fee 1000000ugnot -gas-wanted 200000000 -broadcast -chainid=tendermint_test test1
stdout OK!

gnokey maketx call -pkgpath gno.land/r/kourt/kourtv2 -func SetSiteDomain -args kourt.xyz -gas-fee 1000000ugnot -gas-wanted 100000000 -broadcast -chainid=tendermint_test test1
stdout OK!

# Claims cost a refundable CC deposit, so buy into the court's curve first.
gnokey maketx call -pkgpath gno.land/r/kourt/kourtv2 -func Buy -args med -send 50000000ugnot -gas-fee 1000000ugnot -gas-wanted 200000000 -broadcast -chainid=tendermint_test test1
stdout OK!

# --- A claim carrying evidence -------------------------------------------------
# The argument is exactly what web/media.js builds: kind|sha256|mime|w|h|bytes|
# caption|mirrors. If the two ever disagree about the field order or the
# separator, this transaction fails and says so.
gnokey maketx call -pkgpath gno.land/r/kourt/kourtv2 -func OpenClaimPM -args med -args 'Did the memo say that?' -args 'The memo is the whole question.' -args 'img|1111111111111111111111111111111111111111111111111111111111111111|image/webp|800|600|90210|the memo|https://i.imgur.com/abc.webp' -gas-fee 1000000ugnot -gas-wanted 200000000 -broadcast -chainid=tendermint_test test1
stdout OK!

# A second claim with no evidence at all, so the batch below has a hole to hold.
gnokey maketx call -pkgpath gno.land/r/kourt/kourtv2 -func OpenClaim -args med -args 'A claim carrying nothing' -gas-fee 1000000ugnot -gas-wanted 100000000 -broadcast -chainid=tendermint_test test1
stdout OK!

# --- What the overlay reads ----------------------------------------------------
# One line of JSON. The overlay's qeval parser splits raw output on newlines
# BEFORE it matches a typed value, so a payload with a newline in it parses as
# garbage — this is the assertion that catches that over a real wire.
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv2.ClaimMedia(\"med\", 1)"
# qeval wraps a string result as ("..." string) with the inner quotes escaped,
# so the payload reads \"kind\":\"img\" on the wire. Asserted in that form
# rather than the pretty one: this is what a client actually parses.
stdout 'data: \("\[\{\\"kind\\":\\"img\\"'
stdout 'sha256\\":\\"1111111111111111111111111111111111111111111111111111111111111111'
stdout 'caption\\":\\"the memo'
stdout 'mirrors\\":\[\\"https://i.imgur.com/abc.webp'
# ONE LINE. The overlay's parser splits raw output on newlines before it matches
# a typed value, so the payload closing on the same line it opened is the whole
# contract — a multi-line answer parses as garbage.
stdout '\}\]" string\)'

# A claim carrying nothing answers with an empty array, never an error: the map
# asks for every claim it draws.
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv2.ClaimMedia(\"med\", 2)"
stdout 'data: \("\[\]" string\)'

# --- The batch the map draws from ----------------------------------------------
# One read for a run of claims, with position i meaning claim fromID+i. Claim 3
# does not exist and must be a hole rather than an abort, or thumbnails land on
# the wrong nodes.
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv2.ClaimMediaPage(\"med\", 1, 3)"
stdout 'caption\\":\\"the memo'
stdout '\],\[\],\[\]\]" string\)'

# --- The page a reader meets ---------------------------------------------------
# THE DESTINATION IS THE ARCHIVE, NOT THE MIRROR THE FILER NAMED. A markdown
# image has one destination and no onerror, and gnoweb cannot verify what comes
# back, so pointing at a filer-chosen host would make every claim page a small
# amplifier aimed wherever they liked.
gnokey query vm/qrender --data "gno.land/r/kourt/kourtv2:med/1"
stdout 'Evidence filed with this claim'
stdout 'Exhibit 1 of 1'
stdout 'https://kourt\.xyz/m/1111111111111111111111111111111111111111111111111111111111111111'
! stdout 'i\.imgur\.com'

# --- A purge takes it off every surface at once ---------------------------------
gnokey maketx call -pkgpath gno.land/r/kourt/kourtv2 -func PurgeClaimMedia -args med -args 1 -args 0 -args csam -gas-fee 1000000ugnot -gas-wanted 200000000 -broadcast -chainid=tendermint_test test1
stdout OK!

# The slot survives, tombstoned: removing it would shift every later index, so a
# moderator's next call would land on an exhibit they had already reviewed.
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv2.ClaimMedia(\"med\", 1)"
stdout 'purged\\":true'
! stdout 'i\.imgur\.com'
! stdout 'the memo'

# And the page says what happened rather than quietly dropping a number.
gnokey query vm/qrender --data "gno.land/r/kourt/kourtv2:med/1"
stdout 'Exhibit 1 of 1 was taken down'
! stdout 'kourt\.xyz/m/1111'

# The claim itself is untouched: a purge removes evidence, never the record that
# a claim was filed.
gnokey query vm/qeval --data "gno.land/r/kourt/kourtv2.ClaimClosed(\"med\", 1)"
stdout 'false'
