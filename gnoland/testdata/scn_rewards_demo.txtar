loadpkg gno.land/r/kourt/kourtv2

# Actors. adduser must precede `gnoland start`, so these hoist.
adduser alice 900000000ugnot
adduser bob 900000000ugnot

gnoland start


# --- arm the clock — both halves of it ---------------------------------
gnokey query vm/qeval --data '"gno.land/r/kourt/kourtv2.TestClockActive()"'
stdout 'false'

gnokey maketx call -pkgpath gno.land/r/kourt/kourtv2 -func EnableTestClockAt -args '1780000000' -gas-fee 1000000ugnot -gas-wanted 200000000 -broadcast -chainid=tendermint_test test1
stdout 'OK!'


# --- a court with real coin, and one claim staked ----------------------
gnokey maketx call -pkgpath gno.land/r/kourt/kourtv2 -func StartCourt -args 'orem' -args 'Orem Truth Court' -gas-fee 1000000ugnot -gas-wanted 200000000 -broadcast -chainid=tendermint_test alice
stdout 'OK!'

gnokey maketx call -pkgpath gno.land/r/kourt/kourtv2 -func Buy -args 'orem' -send 400000000ugnot -gas-fee 1000000ugnot -gas-wanted 200000000 -broadcast -chainid=tendermint_test alice
stdout 'OK!'

gnokey maketx call -pkgpath gno.land/r/kourt/kourtv2 -func Buy -args 'orem' -send 400000000ugnot -gas-fee 1000000ugnot -gas-wanted 200000000 -broadcast -chainid=tendermint_test bob
stdout 'OK!'

gnokey maketx call -pkgpath gno.land/r/kourt/kourtv2 -func OpenClaim -args 'orem' -args 'The county certified 12,412 mail ballots on Nov 6, 2025.' -gas-fee 1000000ugnot -gas-wanted 200000000 -broadcast -chainid=tendermint_test alice
stdout 'OK!'

gnokey maketx call -pkgpath gno.land/r/kourt/kourtv2 -func Stake -args 'orem' -args '1' -args '0' -args '400000000' -gas-fee 1000000ugnot -gas-wanted 200000000 -broadcast -chainid=tendermint_test alice
stdout 'OK!'


# --- ripen the trailing average — 2,160 blocks, one transaction --------
# answerWindow, without producing a block
gnokey maketx call -pkgpath gno.land/r/kourt/kourtv2 -func AdvanceTestHeight -args '2200' -gas-fee 1000000ugnot -gas-wanted 200000000 -broadcast -chainid=tendermint_test test1
stdout 'OK!'

gnokey maketx call -pkgpath gno.land/r/kourt/kourtv2 -func Stake -args 'orem' -args '1' -args '0' -args '1000000' -gas-fee 1000000ugnot -gas-wanted 200000000 -broadcast -chainid=tendermint_test alice
stdout 'OK!'

gnokey maketx call -pkgpath gno.land/r/kourt/kourtv2 -func PostAnswer -args 'orem' -args '1' -args '0' -gas-fee 1000000ugnot -gas-wanted 200000000 -broadcast -chainid=tendermint_test bob
stdout 'OK!'

gnokey query vm/qeval --data '"gno.land/r/kourt/kourtv2.HasAnswer(\"orem\",1)"'
stdout 'true'


# --- settle: 72 hours on the calendar half -----------------------------
# just past the settle window
gnokey maketx call -pkgpath gno.land/r/kourt/kourtv2 -func AdvanceTestClock -args '259260' -gas-fee 1000000ugnot -gas-wanted 200000000 -broadcast -chainid=tendermint_test test1
stdout 'OK!'

gnokey maketx call -pkgpath gno.land/r/kourt/kourtv2 -func SettleUndisputed -args 'orem' -args '1' -gas-fee 1000000ugnot -gas-wanted 200000000 -broadcast -chainid=tendermint_test alice
stdout 'OK!'

gnokey query vm/qeval --data '"gno.land/r/kourt/kourtv2.Settled(\"orem\",1)"'
stdout 'true'


# --- the quiet window: 17,280 blocks, and this is the part that cost 2 hours 
